{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.dev/schema/dispatch-policy.schema.json",
  "title": "AI-SDLC Dispatch Policy",
  "type": "object",
  "required": ["version", "routes", "task_templates"],
  "properties": {
    "version": {"type": "string", "const": "0.1.0"},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "match", "runtime"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "default": 0},
          "match": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "stage": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "risk": {"enum": ["low", "medium", "high"]}
            },
            "additionalProperties": false
          },
          "runtime": {
            "type": "object",
            "required": ["id", "mode"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "mode": {"enum": ["manual", "assisted", "autonomous"]}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "task_templates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/task_template"}
    },
    "profile_task_templates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {"$ref": "#/$defs/task_template"}
      }
    }
  },
  "$defs": {
    "task_template": {
      "type": "object",
      "required": ["goal", "read", "expected_outputs", "definition_of_done"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "read": {"type": "array", "items": {"type": "string"}},
        "allowed_scope": {"type": "array", "items": {"type": "string"}},
        "forbidden_scope": {"type": "array", "items": {"type": "string"}},
        "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
