{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ai-sdlc.dev/schema/operator/store/operation-event.schema.json","title":"AI-SDLC Operation Event v1","type":"object","required":["schema_version","operation_id","operation_generation","sequence","event_id","event_type","occurred_at","trusted_context_digest","payload"],"properties":{"schema_version":{"const":"ai-sdlc.operation-event/v1"},"operation_id":{"type":"string","pattern":"^[A-Za-z0-9._:-]{1,128}$"},"operation_generation":{"type":"integer","minimum":0},"sequence":{"type":"integer","minimum":1},"event_id":{"type":"string","pattern":"^[A-Za-z0-9._:-]{1,160}$"},"event_type":{"type":"string","minLength":1,"maxLength":128},"occurred_at":{"type":"string","minLength":1,"maxLength":64},"trusted_context_digest":{"type":"string","minLength":1,"maxLength":128},"payload":{"type":"object"}},"additionalProperties":false}
