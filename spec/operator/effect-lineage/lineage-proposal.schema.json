{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-sdlc.effect-lineage-proposal/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","proposal_id","effect_lineage_id","predecessor_semantic_effect_key","proposed_semantic_effect_key","proposed_exact_semantic_material","current_feature_revision","current_stage","current_target_ref","current_candidate_head_sha","operation_id","operation_generation","trusted_profile_digest","proposed_at","trusted_context_digest"],
  "properties": {
    "schema_version": {"const": "ai-sdlc.effect-lineage-proposal/v1"},
    "proposal_id": {"type": "string", "pattern": "^prop-[0-9a-f]{48}$"},
    "effect_lineage_id": {"type": "string", "pattern": "^lin-[0-9a-f]{48}$"},
    "predecessor_semantic_effect_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposed_semantic_effect_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposed_exact_semantic_material": {"type": "object"},
    "current_feature_revision": {"type": "integer", "minimum": 0},
    "current_stage": {"type": "string", "minLength": 1},
    "current_target_ref": {"type": "string", "minLength": 1},
    "current_candidate_head_sha": {"type": ["string","null"]},
    "operation_id": {"type": "string", "minLength": 1},
    "operation_generation": {"type": "integer", "minimum": 0},
    "trusted_profile_digest": {"type": "string", "minLength": 1},
    "proposed_at": {"type": "string", "minLength": 1},
    "trusted_context_digest": {"type": "string", "minLength": 1}
  }
}
