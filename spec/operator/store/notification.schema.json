{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ai-sdlc.dev/schema/operator/store/notification.schema.json","title":"AI-SDLC Durable Notification v1","type":"object","required":["schema_version","notification_id","notification_type","target_repository","feature_id","operation_id","operation_generation","semantic_key","created_at","trusted_context_digest"],"properties":{"schema_version":{"const":"ai-sdlc.notification/v1"},"notification_id":{"type":"string","pattern":"^[A-Za-z0-9._:-]{1,128}$"},"notification_type":{"enum":["decision.requested","operation.blocked","operation.completed","authorization.expiring"]},"target_repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"feature_id":{"type":"string","minLength":1,"maxLength":160},"operation_id":{"type":"string","pattern":"^[A-Za-z0-9._:-]{1,128}$"},"operation_generation":{"type":"integer","minimum":0},"decision_id":{"type":["string","null"],"pattern":"^[A-Za-z0-9._:-]{1,128}$"},"semantic_key":{"type":"string","minLength":1,"maxLength":256},"summary":{"type":"string","maxLength":512},"created_at":{"type":"string","format":"date-time"},"trusted_context_digest":{"type":"string","minLength":1,"maxLength":128}},"additionalProperties":false}
