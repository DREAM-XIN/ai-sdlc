{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.dev/schema/task-execution.schema.json",
  "title": "AI-SDLC Task Execution",
  "type": "object",
  "required": ["id", "task_id", "runtime_id", "state", "updated_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "feature_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "runtime_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["READY", "STARTED", "BLOCKED", "SUBMITTED", "COMPLETED", "FAILED"]},
    "previous_state": {"enum": ["READY", "STARTED", "BLOCKED", "SUBMITTED"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "reason": {"type": "string", "minLength": 1},
    "failure_detail": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "actor": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "BLOCKED"}}, "required": ["state"]},
      "then": {"required": ["previous_state", "reason"]}
    },
    {
      "if": {"properties": {"state": {"const": "FAILED"}}, "required": ["state"]},
      "then": {"required": ["previous_state", "failure_detail"]}
    },
    {
      "if": {"properties": {"state": {"const": "COMPLETED"}}, "required": ["state"]},
      "then": {"required": ["previous_state", "evidence"]}
    },
    {
      "if": {"properties": {"state": {"enum": ["STARTED", "SUBMITTED"]}}, "required": ["state"]},
      "then": {"required": ["previous_state"]}
    },
    {
      "if": {"properties": {"state": {"const": "READY"}}, "required": ["state"]},
      "then": {"not": {"required": ["previous_state"]}}
    }
  ],
  "additionalProperties": false
}
