{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.dev/runtime/gh-aw/worker-result.schema.json",
  "title": "AI-SDLC gh-aw Worker Result",
  "type": "object",
  "required": ["version", "id", "feature_id", "task_id", "stage", "expected_revision", "status", "occurred_at", "artifacts", "evidence"],
  "properties": {
    "version": {"type": "string", "const": "0.1.0"},
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$"},
    "feature_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "work_kind": {"enum": ["stage", "remediation"]},
    "expected_revision": {"type": "integer", "minimum": 0},
    "status": {"enum": ["COMPLETED", "BLOCKED", "FAILED"]},
    "reason": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "uri"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "status", "uri"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "warning", "unknown"]},
          "uri": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["BLOCKED", "FAILED"]}}},
      "then": {"required": ["reason"]}
    }
  ],
  "additionalProperties": false
}
