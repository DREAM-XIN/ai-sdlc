{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.dev/schema/commander-plan.schema.json",
  "title": "AI-SDLC Commander Plan",
  "type": "object",
  "required": ["version", "feature_id", "outcome", "errors", "summary", "dispatches"],
  "properties": {
    "version": {"type": "string", "const": "0.1.0"},
    "feature_id": {"type": ["string", "null"]},
    "outcome": {"enum": ["DISPATCH", "WAIT", "BLOCKED", "COMPLETE", "INVALID"]},
    "errors": {"type": "array", "items": {"type": "string"}},
    "summary": {
      "type": "object",
      "required": ["workflow_status", "current_stage"],
      "properties": {
        "workflow_status": {"type": ["string", "null"], "enum": ["ACTIVE", "BLOCKED", "DONE", "CANCELLED", null]},
        "current_stage": {"type": ["string", "null"]},
        "revision": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "dispatches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "route_ids", "runtime"],
        "properties": {
          "action": {
            "type": "object",
            "required": ["stage", "role", "parallel"],
            "properties": {
              "stage": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "gate": {"type": ["string", "null"]},
              "parallel": {"type": "boolean"},
              "kind": {"enum": ["stage", "remediation"]},
              "task_id": {"type": "string", "minLength": 1},
              "source_stage": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "route_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "runtime": {
            "type": "object",
            "required": ["id", "mode"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "mode": {"enum": ["manual", "assisted", "autonomous"]}
            },
            "additionalProperties": false
          },
          "task": {"type": "object"},
          "package": {"type": "object"},
          "prompt": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
