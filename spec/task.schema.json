{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.dev/schema/task.schema.json",
  "title": "AI-SDLC Task",
  "type": "object",
  "required": ["id", "role", "goal", "definition_of_done"],
  "properties": {
    "id": {"type": "string"},
    "kind": {"enum": ["stage", "remediation"], "default": "stage"},
    "feature_id": {"type": "string"},
    "role": {"type": "string"},
    "goal": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "allowed_scope": {"type": "array", "items": {"type": "string"}},
    "forbidden_scope": {"type": "array", "items": {"type": "string"}},
    "expected_outputs": {"type": "array", "items": {"type": "string"}},
    "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "runtime": {"type": "string"},
    "max_attempts": {"type": "integer", "minimum": 1, "default": 3}
  },
  "additionalProperties": false
}
