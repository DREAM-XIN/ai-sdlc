{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://ai-sdlc.dev/schema/operator/store/decision.schema.json","title":"AI-SDLC Durable Decision v1","type":"object","required":["schema_version","decision_id","decision_type","target_repository","feature_id","operation_id","operation_generation","expected_revision","target_ref","allowed_choices","trusted_policy_ref","trusted_policy_epoch","trusted_policy_digest","requested_by","requested_at","expires_at","trusted_context_digest"],"properties":{"schema_version":{"const":"ai-sdlc.decision/v1"},"decision_id":{"type":"string","pattern":"^[A-Za-z0-9._:-]{1,128}$"},"decision_type":{"type":"string","pattern":"^[A-Za-z0-9._:-]{1,128}$"},"target_repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"feature_id":{"type":"string","minLength":1,"maxLength":160},"operation_id":{"type":"string","pattern":"^[A-Za-z0-9._:-]{1,128}$"},"operation_generation":{"type":"integer","minimum":0},"expected_revision":{"type":"integer","minimum":0},"target_ref":{"type":"string","minLength":1,"maxLength":512},"candidate_head_sha":{"type":["string","null"],"pattern":"^[0-9a-f]{40}$"},"allowed_choices":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9._:-]{1,128}$"}},"choice_actions":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","pattern":"^[A-Za-z0-9._:-]{1,128}$"}},"trusted_policy_ref":{"type":"string","minLength":1,"maxLength":512},"trusted_policy_epoch":{"type":"string","minLength":1,"maxLength":128},"trusted_policy_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"requested_by":{"type":"string","minLength":1,"maxLength":256},"requested_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"trusted_context_digest":{"type":"string","minLength":1,"maxLength":128}},"additionalProperties":false}
