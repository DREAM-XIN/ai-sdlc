{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.dev/schema/task-package.schema.json",
  "title": "AI-SDLC Portable Task Package",
  "type": "object",
  "required": ["version", "task", "context", "instructions", "handoff"],
  "properties": {
    "version": {"type": "string", "const": "0.1.0"},
    "task": {
      "type": "object",
      "required": ["id", "role", "goal", "definition_of_done"],
      "properties": {
        "id": {"type": "string"},
        "feature_id": {"type": "string"},
        "role": {"type": "string"},
        "goal": {"type": "string", "minLength": 1},
        "allowed_scope": {"type": "array", "items": {"type": "string"}},
        "forbidden_scope": {"type": "array", "items": {"type": "string"}},
        "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["system_of_record", "repository", "read"],
      "properties": {
        "system_of_record": {"enum": ["github", "gitlab", "other"]},
        "repository": {"type": "string"},
        "read": {"type": "array", "items": {"type": "string"}},
        "project_rules": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "instructions": {
      "type": "object",
      "required": ["role_contract", "execution"],
      "properties": {
        "role_contract": {"type": "string"},
        "execution": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "escalation": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "handoff": {
      "type": "object",
      "required": ["write_back", "completion_detection"],
      "properties": {
        "write_back": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "completion_detection": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "blocked_format": {"type": "string"}
      },
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "properties": {
        "runtime": {"type": "string", "default": "chatgpt-web"},
        "mode": {"enum": ["manual", "assisted", "autonomous"], "default": "manual"},
        "conversation_ref": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
