{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dream-xin.github.io/ai-sdlc/spec/operator/dogfood-evidence.schema.json",
  "title": "AI-SDLC v0.3 Dogfood Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_kind", "scenario", "run_id", "recorded_at", "repository", "feature_id", "target_ref", "candidate", "operation", "adapter", "runtime", "provenance", "start_state", "end_state", "milestones", "counts", "assertions", "evidence_uris", "verdict", "release_eligible"],
  "properties": {
    "schema_version": {"const": "ai-sdlc.v0.3-dogfood-evidence/v1"},
    "evidence_kind": {"enum": ["deterministic-fixture", "release-run"]},
    "scenario": {"enum": ["happy_path", "review_remediation", "session_recovery"]},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "feature_id": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string", "minLength": 1},
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["pr_number", "head_sha"],
      "properties": {
        "pr_number": {"type": ["integer", "null"], "minimum": 1},
        "head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false, "required": ["operation_id", "generation"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^op-[A-Za-z0-9._:-]+$"},
        "generation": {"type": "integer", "minimum": 0}
      }
    },
    "adapter": {
      "type": "object", "additionalProperties": false, "required": ["adapter_id", "supported", "write_capable"],
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1},
        "supported": {"type": "boolean"},
        "write_capable": {"type": "boolean"}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["runtime_kind", "real_supported_runtime", "receipt_identity", "workflow_run_ids"],
      "properties": {
        "runtime_kind": {"type": "string", "minLength": 1},
        "real_supported_runtime": {"type": "boolean"},
        "receipt_identity": {"type": ["string", "null"]},
        "workflow_run_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_status", "verifier_identity", "attestation_uri"],
      "properties": {
        "verification_status": {"enum": ["NOT_APPLICABLE", "PENDING", "VERIFIED"]},
        "verifier_identity": {"type": ["string", "null"], "minLength": 1},
        "attestation_uri": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "start_state": {"type": "string", "minLength": 1},
    "end_state": {"type": "string", "minLength": 1},
    "milestones": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "name", "state_after", "evidence_categories", "evidence_uris"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "state_after": {"type": "string", "minLength": 1},
          "evidence_categories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["operation", "candidate", "runtime_receipt", "independent_review", "decision", "remediation", "verification", "notification", "persisted_state", "session_recovery"]
            }
          },
          "evidence_uris": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false, "required": ["human_interventions", "repeated_continue_messages"],
      "properties": {
        "human_interventions": {"type": "integer", "minimum": 0},
        "repeated_continue_messages": {"type": "integer", "minimum": 0}
      }
    },
    "assertions": {
      "type": "object", "additionalProperties": false,
      "required": ["durable_operation_state", "no_repeated_continue_messages", "independent_review_observed", "remediation_round_trip_observed", "new_session_discovery_observed"],
      "properties": {
        "durable_operation_state": {"type": "boolean"},
        "no_repeated_continue_messages": {"type": "boolean"},
        "independent_review_observed": {"type": "boolean"},
        "remediation_round_trip_observed": {"type": "boolean"},
        "new_session_discovery_observed": {"type": "boolean"}
      }
    },
    "evidence_uris": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "release_eligible": {"type": "boolean"}
  }
}
