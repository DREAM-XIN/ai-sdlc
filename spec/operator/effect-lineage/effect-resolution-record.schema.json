{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-sdlc.effect-resolution-record/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","resolution_id","target_repository","feature_id","effect_lineage_id","predecessor_semantic_effect_key","predecessor_external_dispatch_key","current_operation_id","current_operation_generation","current_feature_revision","current_target_ref","current_candidate_head_sha","successor_proposal_id","successor_proposed_semantic_effect_key","choice","trusted_policy_ref","trusted_policy_digest","resolver_identity","evidence_digests","authority_id","evidence","resolved_at","trusted_context_digest"],
  "properties": {
    "schema_version": {"const": "ai-sdlc.effect-resolution-record/v1"},
    "resolution_id": {"type": "string", "pattern": "^res-[0-9a-f]{48}$"},
    "target_repository": {"type": "string", "minLength": 3},
    "feature_id": {"type": "string", "minLength": 1},
    "effect_lineage_id": {"type": "string", "pattern": "^lin-[0-9a-f]{48}$"},
    "predecessor_semantic_effect_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "predecessor_external_dispatch_key": {"type": "string", "pattern": "^dispatch-[0-9a-f]{40}$"},
    "current_operation_id": {"type": "string", "minLength": 1},
    "current_operation_generation": {"type": "integer", "minimum": 0},
    "current_feature_revision": {"type": "integer", "minimum": 0},
    "current_target_ref": {"type": "string", "minLength": 1},
    "current_candidate_head_sha": {"type": ["string","null"]},
    "successor_proposal_id": {"type": ["string","null"]},
    "successor_proposed_semantic_effect_key": {"type": ["string","null"]},
    "choice": {"enum": ["CORRELATE_EXISTING_RECEIPT","PROVE_NOT_LAUNCHED","RETIRE_OBSOLETE_NO_DUPLICATE_PROVEN","REMAIN_BLOCKED"]},
    "trusted_policy_ref": {"type": "string", "minLength": 1},
    "trusted_policy_digest": {"type": "string", "minLength": 1},
    "resolver_identity": {"type": "string", "minLength": 1},
    "evidence_digests": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "authority_id": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "resolved_at": {"type": "string", "minLength": 1},
    "trusted_context_digest": {"type": "string", "minLength": 1}
  }
}
