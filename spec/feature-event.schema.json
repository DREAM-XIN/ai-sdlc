{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.dev/schema/feature-event.schema.json",
  "title": "AI-SDLC Feature Event",
  "type": "object",
  "required": ["version", "feature_id", "occurred_at", "changes"],
  "properties": {
    "version": {"type": "string", "const": "0.1.0"},
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$"},
    "feature_id": {"type": "string", "minLength": 1},
    "expected_revision": {"type": "integer", "minimum": 0},
    "occurred_at": {"type": "string", "format": "date-time"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "id", "status"],
            "properties": {
              "kind": {"const": "stage"},
              "id": {"type": "string", "minLength": 1},
              "status": {"enum": ["READY", "WORKING", "REVIEW", "DONE", "BLOCKED", "SKIPPED"]},
              "reason": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {"if": {"properties": {"status": {"const": "BLOCKED"}}}, "then": {"required": ["reason"]}}
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["kind", "record"],
            "properties": {
              "kind": {"const": "task-record"},
              "record": {
                "type": "object",
                "required": ["id", "kind", "stage", "role", "source_stage", "feedback", "status"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "kind": {"const": "remediation"},
                  "stage": {"type": "string", "minLength": 1},
                  "role": {"type": "string", "minLength": 1},
                  "source_stage": {"type": "string", "minLength": 1},
                  "feedback": {"type": "string", "minLength": 1},
                  "target_pr": {"type": "string", "minLength": 1},
                  "status": {"enum": ["TODO", "READY"]},
                  "issue": {"type": "string"},
                  "runtime": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["kind", "id", "status"],
            "properties": {
              "kind": {"const": "task"},
              "id": {"type": "string", "minLength": 1},
              "status": {"enum": ["READY", "WORKING", "DONE", "BLOCKED", "FAILED"]},
              "reason": {"type": "string", "minLength": 1}
            },
            "allOf": [
              {"if": {"properties": {"status": {"enum": ["BLOCKED", "FAILED"]}}}, "then": {"required": ["reason"]}}
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["kind", "id", "status"],
            "properties": {
              "kind": {"const": "gate"},
              "id": {"type": "string", "minLength": 1},
              "status": {"enum": ["PENDING", "PASS", "FAIL", "WAIVED"]},
              "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["kind", "record"],
            "properties": {
              "kind": {"const": "evidence"},
              "record": {
                "type": "object",
                "required": ["id", "type", "status", "uri"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "type": {"type": "string", "minLength": 1},
                  "status": {"enum": ["pass", "fail", "warning", "unknown"]},
                  "uri": {"type": "string", "minLength": 1}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
