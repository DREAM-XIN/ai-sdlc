{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.dev/schema/operator/capabilities.schema.json",
  "title": "AI-SDLC Operator capability discovery",
  "type": "object",
  "required": ["supported_api_versions", "capabilities"],
  "properties": {"supported_api_versions": {"type": "array", "items": {"const": "ai-sdlc.operator/v1"}, "minItems": 1, "uniqueItems": true}, "capabilities": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object", "required": ["id", "available"], "properties": {"id": {"enum": ["system.capabilities", "project.inspect", "feature.status", "operator.inbox", "operation.start", "operation.status", "operation.resume", "operation.cancel", "decision.list", "decision.respond", "notification.list", "notification.ack"]}, "available": {"type": "boolean"}, "reason": {"enum": ["AVAILABLE", "BACKEND_NOT_IMPLEMENTED", "BACKEND_NOT_CONFIGURED", "POLICY_RESTRICTED"]}}, "additionalProperties": false}}},
  "additionalProperties": false
}
