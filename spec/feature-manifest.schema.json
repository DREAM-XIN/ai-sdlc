{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.dev/schema/feature-manifest.schema.json",
  "title": "AI-SDLC Feature Manifest",
  "type": "object",
  "required": ["protocol_version", "feature", "workflow", "updated_at"],
  "properties": {
    "protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "revision": {"type": "integer", "minimum": 0},
    "feature": {
      "type": "object",
      "required": ["id", "title", "risk"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "risk": {"enum": ["low", "medium", "high"]},
        "issue": {"type": "string"}
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["profile", "status", "current_stage", "stages"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "status": {"enum": ["ACTIVE", "BLOCKED", "DONE", "CANCELLED"]},
        "current_stage": {"type": "string", "minLength": 1},
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"enum": ["TODO", "READY", "WORKING", "REVIEW", "DONE", "BLOCKED", "SKIPPED"]},
              "gate": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["TODO", "READY", "WORKING", "BLOCKED", "REVIEW", "DONE", "FAILED"]},
          "issue": {"type": "string"},
          "runtime": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "uri"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "status": {"enum": ["draft", "approved", "superseded"]}
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PENDING", "PASS", "FAIL", "WAIVED"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "status", "uri"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "warning", "unknown"]},
          "uri": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "applied_events": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$"}
    },
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
