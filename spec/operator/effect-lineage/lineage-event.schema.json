{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-sdlc.effect-lineage-event/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","effect_lineage_id","sequence","event_id","event_type","occurred_at","trusted_context_digest","payload"],
  "properties": {
    "schema_version": {"const": "ai-sdlc.effect-lineage-event/v1"},
    "effect_lineage_id": {"type": "string", "pattern": "^lin-[0-9a-f]{48}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["lineage.root-activated","lineage.successor-proposed","lineage.predecessor-blocked","lineage.predecessor-correlated","lineage.predecessor-retired","lineage.successor-activated","lineage.member-superseded","lineage.member-adopted","lineage.legacy-attached","lineage.legacy-unresolved","lineage.resolution-applied"]},
    "occurred_at": {"type": "string", "minLength": 1},
    "trusted_context_digest": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  }
}
