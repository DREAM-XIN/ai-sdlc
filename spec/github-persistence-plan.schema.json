{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-sdlc.dev/schema/github-persistence-plan.schema.json",
  "title": "AI-SDLC GitHub Persistence Plan",
  "type": "object",
  "required": ["version", "repository", "target", "manifest", "mutations", "summary"],
  "properties": {
    "version": {"type": "string", "const": "0.1.0"},
    "repository": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "required": ["ref", "manifest_path"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "manifest_path": {"type": "string", "minLength": 1},
        "issue": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "required": ["feature_id", "sha256", "content"],
      "properties": {
        "feature_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "content": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "path", "ref", "sha256"],
            "properties": {
              "kind": {"const": "update-file"},
              "path": {"type": "string"},
              "ref": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["kind", "issue", "body"],
            "properties": {
              "kind": {"const": "issue-comment"},
              "issue": {"type": "integer", "minimum": 1},
              "body": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["kind", "name", "conclusion", "summary"],
            "properties": {
              "kind": {"const": "check-run"},
              "name": {"type": "string", "minLength": 1},
              "conclusion": {"enum": ["success", "failure", "neutral"]},
              "summary": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "required": ["workflow_status", "current_stage", "message"],
      "properties": {
        "workflow_status": {"enum": ["ACTIVE", "BLOCKED", "DONE", "CANCELLED"]},
        "current_stage": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
